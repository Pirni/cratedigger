# REQUIRED
# Port the HTTP server listens on.
PORT=3000

# REQUIRED
# Spotify API credentials (https://developer.spotify.com/dashboard).
# SPOTIFY_REDIRECT_URI must be listed verbatim in the app's Redirect URIs there.
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# REQUIRED
# Root directory containing all user music libraries.
LIBRARY_ROOT=/music

# Comma-separated allowlist of Spotify user ids. Logging in with one of these grants
# the admin role: listing users, deleting them, and setting their Jellyfin library path.
# Empty or missing means nobody is an admin yet, which is a valid state.
ADMIN_SPOTIFY_IDS=31xk7f2qha8w9,22bq9m4ztc1p7

# REQUIRED
# Path to the yt-dlp binary. A bare name is resolved via PATH.
YTDLP_PATH=yt-dlp.exe

# REQUIRED
# How many downloads may run at once, across the whole backend.
MAX_PARALLEL_DOWNLOADS=3

# REQUIRED
# Postgres. docker-compose.yaml points the db container's env_file at this file,
# so these create the database on first start and are also what the backend connects with.
POSTGRES_DB=cratedigger
POSTGRES_USER=cratedigger
POSTGRES_PASSWORD=change_me

# REQUIRED
# How the backend connects to the database above. Host and port are the ones
# published by docker-compose.yaml.
DATABASE_URL=postgres://cratedigger:change_me@127.0.0.1:5432/cratedigger

# REQUIRED
# Signing key for the bearer tokens. HS256 — use at least 32 random bytes.
JWT_SECRET=change_me_to_32_plus_random_bytes

# REQUIRED
# Where the OAuth callback sends the browser once login succeeds. The signed-in
# token is appended as a ?token= query parameter.
FRONTEND_URL=http://127.0.0.1:5173/
